NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# Frontend public URL for OpenGraph metadata (Optional, defaults to deployment origin)
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# GitHub repository link for footer (Optional)
NEXT_PUBLIC_GITHUB_URL=https://github.com/harshitsaxena214/tapremit
